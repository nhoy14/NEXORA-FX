# NEXORA FX — Environment Configuration Example

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# Market Data Pipeline Settings
# Supported provider routers: "auto" (smart multi-provider), "mt5", "binance", "kraken", "yahoo", "xaus"
DEFAULT_DATA_PROVIDER=auto
CACHE_TTL_SECONDS=10

# Default Strategy Parameters
DEFAULT_TIMEFRAME=M15
DEFAULT_MIN_SCORE=70
EMA_FAST=9
EMA_MEDIUM=21
EMA_SLOW=50
EMA_BASELINE=200
EMA_200_FILTER=true

# Optional Third-Party Data Provider API Keys (Commercial / Free-Tier)
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=

# Note on Verified Data Feeds:
# - MetaTrader 5 (MT5): Requires running MT5 desktop terminal logged into broker (e.g. Exness, FTMO, IC Markets)
# - Binance Public API: Keyless real-time crypto & physical PAXG spot gold feed
# - Kraken Public API: Keyless real-time spot crypto feed
# - Yahoo Finance: Keyless multi-market global coverage (Forex, CME Futures, Indices, Stocks, Commodities)
# - XAUS API: Keyless public spot London gold and silver feed
# - Twelve Data: Optional; requires TWELVEDATA_API_KEY
